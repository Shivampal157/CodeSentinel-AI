NODE_ENV=development
LOG_LEVEL=debug

API_PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Docker infra (used by docker-compose) ---
MONGO_ROOT_USER=codesentinel
MONGO_ROOT_PASSWORD=change_me_mongo
MONGO_DB=codesentinel
MONGO_PORT=27017

REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- App connection strings (host side) ---
MONGODB_URI=mongodb://codesentinel:change_me_mongo@localhost:27017/codesentinel?authSource=admin
REDIS_URL=redis://:change_me_redis@localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=code_chunks

# --- Auth (Phase 2) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# GitHub OAuth App — https://github.com/settings/developers
# Create an OAuth App with callback: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# --- AI (Phase 4 / 6) ---
# Free embeddings (recommended for local): Gemini text-embedding-004
# Get key: https://aistudio.google.com/apikey
# Paid alternatives: openai | voyage
EMBEDDING_PROVIDER=gemini
OPENAI_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
INDEX_MAX_CHUNKS=600

# Anthropic Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Production behind nginx/load balancer
TRUST_PROXY=false
WEB_PORT=8080
